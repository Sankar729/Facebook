# MongoDB Connection URI
# For local MongoDB (default):
MONGODB_URI=mongodb://localhost:27017/facebook_demo

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/facebook_demo?retryWrites=true&w=majority

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=True

# Database Name
DB_NAME=facebook_demo

# Collection Name
COLLECTION_NAME=logins

# Data URL
DATA_URL=http://127.0.0.1:5000/data

